# Copy to config/relay.env and fill in. Never commit config/relay.env.

# ---------- Shared ----------
MODEL_ID="Qwen/Qwen2.5-1.5B-Instruct"
MAX_MODEL_LEN=4096
VLLM_TAG="REPLACE_WITH_PINNED_VERSION"      # a stable tag from hub.docker.com/r/vllm/vllm-openai
MIN_REPLICAS=1
MAX_REPLICAS=3
CPU_TARGET_PERCENT=60                        # Strategy A, set after calibration
QUEUE_THRESHOLD=5                            # Strategy B, waiting requests per replica
CHECK_INTERVAL_S=15
SCALE_DOWN_WINDOW_S=120
SLO_TTFT_S=2
MAX_NUM_SEQS=256                             # vLLM --max-num-seqs; requests beyond this wait in the queue.
                                             # 256 is the vLLM default. If calibration shows waiting stays 0
                                             # at 60 users, Strategy B can never fire: lower this and record why.
LOCUST_TAG="2.32.3"                          # locustio/locust image tag, match requirements.txt

# ---------- GCP ----------
GCP_PROJECT_ID="REPLACE"
GCP_REGION="us-central1"
GCP_ZONE="us-central1-a"
CLUSTER_NAME="relay"
GPU_POOL="gpu-pool"

# GPU option 1 (default): ONE A100 40GB split into 3 MIG slices, one vLLM replica per slice.
#   Needs quota: GPUs (all regions) >= 1 and NVIDIA A100 GPUs in GCP_REGION >= 1.
#   All replicas share one node, so scale ups never wait for a new node, and the warm spare study does not apply.
#   Check zones: gcloud compute accelerator-types list --filter="name=nvidia-tesla-a100 AND zone~us-central1"
GPU_TYPE="nvidia-tesla-a100"
GPU_MACHINE="a2-highgpu-1g"
GPU_PARTITION_SIZE="2g.10gb"                 # MIG slice: 3 per A100 40GB, 10 GB each. Empty = whole GPU per replica
GPU_ZONES="us-central1-a"                    # ONE zone, so the pool has at most 1 node with quota 1
GPU_POOL_MAX_NODES=1

# GPU option 2: one L4 per replica, the original design. Needs quota of 4 L4s plus GPUs (all regions) 4.
# GPU_TYPE="nvidia-l4"
# GPU_MACHINE="g2-standard-4"
# GPU_PARTITION_SIZE=""
# GPU_ZONES="us-central1-a,us-central1-b,us-central1-c"   # only zones that list nvidia-l4
# GPU_POOL_MAX_NODES=4                       # total across zones; MAX_REPLICAS plus 1 warm spare

CPU_MACHINE="e2-standard-4"                  # runs Prometheus, Grafana, KEDA and Locust
CPU_NODES=1                                  # about $3 per day; use 2 if monitoring pods stay Pending
AR_REPO="relay"
VLLM_IMAGE="${GCP_REGION}-docker.pkg.dev/${GCP_PROJECT_ID}/${AR_REPO}/vllm-openai:${VLLM_TAG}"
KPS_CHART_VERSION=""                         # kube-prometheus-stack chart version; pin before graded runs
KEDA_CHART_VERSION=""                        # KEDA chart version; pin before graded runs
PROM_URL_IN_CLUSTER="http://monitoring-kube-prometheus-prometheus.monitoring.svc:9090"

# ---------- NYU HPC Torch ----------
NETID="REPLACE"
SLURM_ACCOUNT="REPLACE"                      # from: my_slurm_accounts
HPC_GPU_CONSTRAINT="l40s"
RELAY_SCRATCH="/scratch/${NETID}/relay"
HPC_MODEL_DIR="/scratch/${NETID}/models/Qwen2.5-1.5B-Instruct"
HPC_SIF="${RELAY_SCRATCH}/vllm-openai_${VLLM_TAG}.sif"
